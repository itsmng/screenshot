#!/usr/bin/make -f

# Variables
NAME = screenshot
VERSION = CHANGEVERSION

%:
	dh $@

override_dh_auto_install:
	mkdir -p usr/share/itsm-ng/plugins/$(NAME)
	find . -mindepth 1 -maxdepth 1 \
		! -name usr \
		! -name debian \
		! -name tools \
		! -name .git \
		! -name .github \
		! -name README.md \
		! -name 'Screenshot Plugin Preview.gif' \
		! -name 'Logo.png' \
		-exec cp -a {} usr/share/itsm-ng/plugins/$(NAME)/ \;

override_dh_gencontrol:
	dh_gencontrol -- -v$(VERSION)
